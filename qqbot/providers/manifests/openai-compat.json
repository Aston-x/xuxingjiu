{
  "manifest_version": 1,
  "_readme": [
    "云端「OpenAI 兼容」厂商的声明式定义。它们都只说 /chat/completions 这门语言，",
    "差别只在 base_url、鉴权头、以及少数几个字段名 —— 所以一份 JSON 就能全部覆盖。",
    "用法：在 config.json 的 providers.endpoints 里写 provider 为下面某个 name，再填 base_url + model。",
    "例：{\"id\":\"kimi\",\"provider\":\"moonshot\",\"base_url\":\"https://api.moonshot.cn/v1\",",
    "     \"model\":\"moonshot-v1-32k\",\"tier\":\"cloud\",\"api_key_env\":\"MOONSHOT_API_KEY\"}",
    "本文档不预置任何密钥；api_key 一律走环境变量（api_key_env）。",
    "加新厂商：照着拷一段改 base_url / model 即可，不用写代码。"
  ],
  "providers": [
    {
      "name": "deepseek",
      "protocol": "declarative",
      "display_name": "DeepSeek",
      "auth": { "type": "bearer" },
      "request": {
        "path": "/chat/completions",
        "method": "POST",
        "body": {
          "model": "$model",
          "messages": "$messages",
          "stream": false,
          "temperature": "$temperature",
          "max_tokens": "$max_tokens"
        }
      },
      "response": {
        "text": "$.choices[0].message.content",
        "finish_reason": "$.choices[0].finish_reason"
      },
      "usage": {
        "prompt": "$.usage.prompt_tokens",
        "completion": "$.usage.completion_tokens",
        "cache_hit": "$.usage.prompt_cache_hit_tokens",
        "cache_miss": "$.usage.prompt_cache_miss_tokens"
      },
      "capabilities": {
        "vision": false,
        "vision_input": "none",
        "thinking": true,
        "tool_calling": true,
        "streaming": true,
        "max_tokens_key": "max_tokens",
        "max_tokens_limit": 65536,
        "temperature_range": [0.0, 2.0],
        "system_in_messages": true
      },
      "probe": { "path": "/models", "method": "GET", "parse": "openai_models" },
      "_note": "base_url 写 https://api.deepseek.com 即可（它不带 /v1）；带 /v1 也认。thinking 参数请写成端点级 params，别塞给别家。"
    },
    {
      "name": "moonshot",
